# ==============================================================================
# Lumina AI — Caddy Reverse Proxy & Automatic SSL Configuration
# Domain: parasnathpokharel.com.np & www.parasnathpokharel.com.np
# Caddy automatically provisions and renews Let's Encrypt / ZeroSSL certificates.
# ==============================================================================

# Global options
{
    admin off
    email {$LETSENCRYPT_EMAIL:admin@parasnathpokharel.com.np}
}

# Primary Domain — www.parasnathpokharel.com.np
www.parasnathpokharel.com.np {
    # Reverse proxy to Flask/Gunicorn container
    reverse_proxy web:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Enable Gzip and Zstandard compression for performance
    encode gzip zstd

    # Logging
    log {
        output stdout
        format console
    }
}

# Redirect apex domain to www (canonical URL)
parasnathpokharel.com.np {
    redir https://www.parasnathpokharel.com.np{uri} permanent
}
