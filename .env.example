# ==============================================================================
# Lumina AI Background Remover — Environment Configuration
# Domain: www.parasnathpokharel.com.np
# ==============================================================================

# Server Environment
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=5000

# Secret Key — CHANGE THIS before deploying to production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_string

# Database Connection — PostgreSQL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/lumina_bgremover

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=lumina_bgremover

# Persistent Storage Root Directory
# In Docker: mapped to the named volume `persistent_storage`
STORAGE_DIR=storage

# AI Model Configuration
U2NET_MODEL=u2net
U2NET_HOME=~/.u2net

# File Upload Limit in bytes (26214400 = 25 MB)
MAX_CONTENT_LENGTH=26214400

# Production Domain Settings
DOMAIN_NAME=parasnathpokharel.com.np
LETSENCRYPT_EMAIL=your_email@example.com

# CORS Allowed Origins
CORS_ORIGINS=https://www.parasnathpokharel.com.np,https://parasnathpokharel.com.np

# Gunicorn WSGI Workers (Linux/Docker)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
