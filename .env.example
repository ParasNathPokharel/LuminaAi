# ==============================================================================
# Lumina AI Background Remover — Environment Configuration
# ==============================================================================

# Server Environment (production / development)
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=5000

# Secret Key for session signing and security cookies
SECRET_KEY=generate_a_strong_random_secret_here_e.g_openssl_rand_hex_32

# Database Connection (PostgreSQL for production; leaves blank for SQLite fallback)
# Example: postgresql://postgres:your_secure_password@db:5432/lumina_bgremover
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_bgremover

# Persistent Storage Root Directory
# Ensure this directory is mounted to a persistent volume in Docker / cloud hosts
STORAGE_DIR=storage

# AI Model Configuration
# Available models: u2net (flagship 176MB), u2netp (lightweight 4.5MB), isnet-general-use
U2NET_MODEL=u2net

# Model Cache Directory (Defaults to ~/.u2net)
U2NET_HOME=~/.u2net

# File Upload Limits (in bytes; 26214400 = 25 MB)
MAX_CONTENT_LENGTH=26214400

# CORS Allowed Origins (Comma-separated, or * for public APIs)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production Domain Settings (for automated Caddy or Nginx reverse proxies)
DOMAIN_NAME=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
